<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="CopyCreatorUpdateMarker" Guid="*" Win64="yes">
        <RegistryValue Root="HKLM" Key="Software\com.copycreator.app\Update"
          Name="ExecutablePath" Value="[INSTALLDIR]copy-creator.exe" Type="string" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
